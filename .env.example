# ---------------------------------------------------------------------------
# Contact form (app/api/contact/route.ts)
# ---------------------------------------------------------------------------
# Resend (https://resend.com) — used to email form submissions.
# Leave unset in local dev; the API route logs submissions instead of sending.
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Optional: Cloudflare Turnstile secret for spam protection.
# NOTE: the contact form does not yet render a Turnstile widget, so setting
# this will make every submission fail verification. Add the widget first.
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Live Google Scholar metrics (lib/scholar.ts)
# ---------------------------------------------------------------------------
# Optional. Without it the site scrapes the public Scholar profile directly,
# which works from most IPs but is sometimes CAPTCHA-blocked from cloud hosts;
# OpenAlex then serves as a free fallback. SerpApi makes it reliable.
# Free tier: 100 searches/month — far more than the twice-daily refresh needs.
SERPAPI_API_KEY=

# ---------------------------------------------------------------------------
# Live GitHub repo stats (lib/github.ts)
# ---------------------------------------------------------------------------
# Optional. Unauthenticated requests are limited to 60/hour per IP; a token
# (no scopes needed for public repos) raises that to 5000/hour.
GITHUB_TOKEN=
